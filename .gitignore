# Flutter/Dart ignore patterns
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/

# Firebase configuration ignores
# android/app/google-services.json
# ios/Runner/GoogleService-Info.plist

# Operating System ignores
.DS_Store
Thumbs.db
   
# Node modules
node_modules/
functions/node_modules/

