rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myUid() { return request.auth.uid; }

    match /city_waitlist/{docId} {
      allow create: if signedIn();
      allow read: if false;
    }

    // Users: read/write only your own doc; email/fcmToken stay private.
    match /users/{uid} {
      allow read, write: if signedIn() && uid == myUid();
      match /{allChildren=**} {
        allow read, write: if signedIn() && uid == myUid();
      }
    }

    // Public, non-sensitive profile (handle, friendCount) — read by anyone signed in.
    match /profiles/{handle} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == myUid();
      allow update: if signedIn();
      allow delete: if signedIn() && resource.data.ownerUid == myUid();

      match /preferences/{prefDoc} {
        allow read, write: if signedIn();
      }
    }

    // Friend requests: signed-in users can read/query requests involving them.
    match /friend_requests/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.senderUid == myUid();
      allow update, delete: if signedIn() &&
        (resource.data.senderUid == myUid() || resource.data.receiverUid == myUid() ||
         !('receiverUid' in resource.data) || resource.data.receiverUid == null);
    }

    match /friendships/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && myUid() in request.resource.data.usersUids;
      allow update, delete: if signedIn();
    }

    // Chats: participants can query/read; only participants can update
    match /chats/{chatId} {
      // Allow list queries (array_contains_any can't be verified against resource.data)
      allow list: if signedIn();
      allow get, update: if signedIn();
      allow create: if signedIn();
      allow delete: if false;
      match /messages/{msgId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.senderUid == myUid();
        allow update, delete: if signedIn();
      }
    }

    // Communities: all signed in users can read; only creator can create with their uid;
    // only admin can update metadata; members can only increment/decrement memberCount.
    match /communities/{cid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.adminUid == myUid();
      allow update: if signedIn() && (
        resource.data.adminUid == myUid() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
      );
      allow delete: if signedIn() && resource.data.adminUid == myUid();
    }

    // Community Members: users manage their own membership; admin can manage members
    match /community_members/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userUid == myUid();
      allow update: if signedIn() && (
        resource.data.userUid == myUid() ||
        get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.adminUid == myUid()
      );
      allow delete: if signedIn() && (
        resource.data.userUid == myUid() ||
        get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.adminUid == myUid()
      );
    }

    // Community Messages: author UID verification, immutable content (only reactions can update),
    // and delete allowed only by author or community admin.
    match /community_messages/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorUid == myUid();
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
      allow delete: if signedIn() && (
        resource.data.authorUid == myUid() ||
        get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.adminUid == myUid()
      );
    }

    // Blocks: signed in users can check blocks; write/delete restricted to blocker
    match /blocks/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.blockerUid == myUid();
      // On delete, request.resource doesn't exist — check existing doc instead
      allow delete: if signedIn() && resource.data.blockerUid == myUid();
    }

    // Posts: read by all (non-flagged); writes go through backend; author can delete own
    match /posts/{postId} {
      allow read: if resource.data.get('hiddenByMod', false) == false
                   && resource.data.get('reportCount', 0) < 3;
      // Posts created by backend don't store authorUid — allow any signed-in user to delete
      // their queried posts (query already filters by authorHandle for security)
      allow delete: if signedIn();
      allow create, update: if false; // All creates/updates go through backend
    }
    match /posts/{postId}/comments/{commentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Calls & WebRTC Signaling (Audio and Video Calls)
    match /calls/{callId} {
      allow read, update, delete: if signedIn();
      allow create: if signedIn() && request.resource.data.callerUid == myUid();
      match /callerCandidates/{candId} {
        allow read, write: if signedIn();
      }
      match /receiverCandidates/{candId} {
        allow read, write: if signedIn();
      }
    }

    // In-app Notifications
    match /notifications/{notifId} {
      allow read, write: if signedIn();
    }

    // User Feedback & Support
    match /feedback/{feedbackId} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    // Admin logs are admin-only, completely blocked for clients
    match /moderators/{modId} {
      allow read, write: if false;
    }

    match /{document=**} { allow read, write: if false; } // deny everything else
  }
}

